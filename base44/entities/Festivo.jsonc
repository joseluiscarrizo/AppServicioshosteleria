{
  "name": "Festivo",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha del festivo"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre del festivo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "nacional",
        "autonomico",
        "local",
        "empresa"
      ],
      "default": "nacional"
    },
    "afecta_todos": {
      "type": "boolean",
      "default": true,
      "description": "Si afecta a todos los camareros"
    }
  },
  "required": [
    "fecha",
    "nombre"
  ]
}